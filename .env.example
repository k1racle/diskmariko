# The repository builds this custom image for both services.
FILEBROWSER_IMAGE=simple-drive-filebrowser:1.5.2-mariko
FILEBROWSER_VERSION=v1.5.2-stable

# Host directories. They are not stored in Git and must exist on the Docker host.
DATA_DIR=/opt/simple-drive/files

# File Browser is published on this host port.
APP_PORT=2340
BIND_ADDRESS=0.0.0.0
