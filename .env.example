# Docker image. Keep the stable channel unless you intentionally test beta builds.
FILEBROWSER_IMAGE=gtstef/filebrowser:stable

# Host directories. They are not stored in Git and must exist on the Docker host.
DATA_DIR=/opt/simple-drive/files
STATE_DIR=/opt/simple-drive/state

# Used only by compose.yaml (HTTP or an existing reverse proxy).
APP_PORT=8080
BIND_ADDRESS=0.0.0.0

# Used only by compose.caddy.yaml. DNS must point to the Docker host.
DOMAIN=disk.mariko-mail.ru
