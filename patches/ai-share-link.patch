diff --git a/frontend/src/utils/aiShareLink.js b/frontend/src/utils/aiShareLink.js
new file mode 100644
--- /dev/null
+++ b/frontend/src/utils/aiShareLink.js
@@ -0,0 +1,16 @@
+/**
+ * Builds a machine-readable URL for a public share. The regular share URL
+ * remains unchanged for people, while this URL returns JSON that AI clients
+ * can inspect without executing the File Browser frontend.
+ *
+ * @param {string} shareURL
+ * @param {string} hash
+ * @returns {string}
+ */
+export function buildAiShareLink(shareURL, hash) {
+  const url = new URL(shareURL, window.location.origin);
+  url.pathname = "/public/api/resources";
+  url.search = new URLSearchParams({ hash, path: "/" }).toString();
+  url.hash = "";
+  return url.toString();
+}
